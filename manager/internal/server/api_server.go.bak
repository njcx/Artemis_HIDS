	// 查询数据
	var alerts []Alert
	if err := query.Order("last_seen DESC").Limit(size).Offset(offset).Find(&alerts).Error; err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"total":  total,
		"alerts": alerts,
		"page":   page,
		"size":   size,
	})
}

