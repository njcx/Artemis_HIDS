# OpenObserve 到 MongoDB 同步工具配置文件 (Docker Compose)
openobserve:
  url: "http://openobserve:5080"
  org: "default"
  username: "${OPENOBSERVE_ROOT_EMAIL}"
  password: "${OPENOBSERVE_ROOT_PASS}"

mongodb:
  uri: "mongodb://${MONGO_ROOT_USERNAME}:${MONGO_ROOT_PASS}@mongodb:27017/artemis_hids?authSource=admin&authMechanism=SCRAM-SHA-256"
  database: "artemis_hids"
  max_pool_size: 100
  min_pool_size: 10
  max_conn_idle_time: 3600

sync:
  poll_interval: 30
  lookback_secs: 300
  batch_size: 100

log:
  level: "info"
  file: "mongo_syncer.log"
  enable_console: true
