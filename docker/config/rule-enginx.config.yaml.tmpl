consumer:
  brokers:
    - "kafka:9092"
  topic: "hids_events-*"
  group_id: "rule-engine-group"
  min_bytes: 1
  max_bytes: 10485760
  auto_offset_reset: "latest"
  num_workers: 16
  channel_size: 50000
  sasl:
    enabled: true
    mechanism: "SCRAM-SHA-256"
    username: "${KAFKA_SASL_USERNAME}"
    password: "${KAFKA_SASL_PASS}"

alert:
  outputs:
    - type: stdout
      enabled: true
      config: {}

    - type: file
      enabled: true
      config:
        path: "./alerts.log"

    - type: kafka
      enabled: true
      config:
        brokers:
          - "kafka:9092"
        topic: "hids_alerts"
        sasl:
          enabled: true
          mechanism: "SCRAM-SHA-256"
          username: "${KAFKA_SASL_USERNAME}"
          password: "${KAFKA_SASL_PASS}"

rules:
  directory: "./rules"

logging:
  level: "info"
  file: "./rule-engine.log"
