consumer:
  brokers:
    - "kafka:9092"
  topic: "hids_events-*"
  group_id: "rule-engine-group"
  min_bytes: 1
  max_bytes: 10485760
  auto_offset_reset: "latest"
  num_workers: 16
  channel_size: 50000
  sasl:
    enabled: true
    mechanism: "SCRAM-SHA-256"
    username: "${KAFKA_SASL_USERNAME}"
    password: "${KAFKA_SASL_PASS}"

alert:
  outputs:
    - type: stdout
      enabled: true
      config: {}

    - type: file
      enabled: true
      config:
        path: "./alerts.log"

    - type: kafka
      enabled: true
      config:
        brokers:
          - "kafka:9092"
        topic: "hids_alerts"
        sasl:
          enabled: true
          mechanism: "SCRAM-SHA-256"
          username: "${KAFKA_SASL_USERNAME}"
          password: "${KAFKA_SASL_PASS}"

mongodb:
  uri: "mongodb://${MONGO_ROOT_USERNAME}:${MONGO_ROOT_PASS}@mongodb:27017/artemis_hids?authSource=admin&authMechanism=SCRAM-SHA-256"
  database: "artemis_hids"
  collection: "rules"
  max_pool_size: 100
  min_pool_size: 10
  max_conn_idle_time: 3600
  poll_interval_secs: 60

logging:
  level: "info"
  file: "./rule-engine.log"
